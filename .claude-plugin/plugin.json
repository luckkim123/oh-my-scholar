{
  "name": "oh-my-scholar",
  "version": "0.12.3",
  "description": "Multi-agent orchestration harness specialized for academic paper work (LaTeX .tex + .bib, concept notes .md) — treats paper writing like code: spec→outline→draft→inspect→verify→revise with citation-integrity guardrails",
  "author": { "name": "kimseungmin" },
  "license": "MIT",
  "keywords": ["claude-code", "plugin", "paper", "latex", "bibtex", "research", "orchestration", "multi-agent", "citation"],
  "skills": [
    "./skills/scholar-init/",
    "./skills/scholar-research/",
    "./skills/scholar-deepen/",
    "./skills/scholar-ideate/",
    "./skills/scholar-outline/",
    "./skills/scholar-draft/",
    "./skills/scholar-inspect/",
    "./skills/scholar-mock-review/",
    "./skills/scholar-verify/",
    "./skills/scholar-revise/",
    "./skills/scholar-learn/",
    "./skills/scholar-pilot/",
    "./skills/scholar-read/",
    "./skills/scholar-discuss/"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scholar_route_emit.py"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scholar_cite_guard.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scholar_verify_emit.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scholar_stop_guard.py"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scholar_resume_emit.py"]
          }
        ]
      }
    ]
  }
}
